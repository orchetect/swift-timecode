raph","inlineContent":[{"text":"This struct can be passed into many methods and initializers.","type":"text"}]},{"code":["let components = Timecode.Components(h: 1)","Timecode(.components(components), at: .fps23_976)","","\/\/ is the same as using the shorthand:","Timecode(.components(h: 1), at: .fps23_976)"],"type":"codeListing","syntax":"swift"},{"code":["let components = try Timecode(.string(\"01:12:20:05\"), at: .fps23_976)","    .components \/\/ Timecode.Components","","components.days      \/\/ == 0","components.hours     \/\/ == 1","components.minutes   \/\/ == 12","components.seconds   \/\/ == 20","components.frames    \/\/ == 5","components.subFrames \/\/ == 0"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw values are stored verbatim and are not implicitly validated or clamped."}]},{"type":"heading","level":2,"text":"Days Component","anchor":"Days-Component"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the Days timecode component."}]},{"type":"paragraph","inlineContent":[{"text":"Although not covered by SMPTE spec, some DAWs (digital audio workstation) such as Cubase support the use of the Days timecode","type":"text"},{"text":" ","type":"text"},{"text":"component for timelines longer than (or outside of) 24 hours.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"By default, ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode","isActive":true},{"text":" is constructed with an ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/upperLimit-swift.property","isActive":true},{"text":" of 24-hour maximum expression (","type":"text"},{"type":"codeVoice","code":".max24Hours"},{"text":") which","type":"text"},{"text":" ","type":"text"},{"text":"suppresses the ability to use Days. To enable Days, set the limit to ","type":"text"},{"type":"codeVoice","code":".max100Days"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The limit setting naturally affects internal timecode validation routines, as well as clamping and wrapping."}]},{"syntax":"swift","code":["\/\/ valid timecode range at 24 fps, with 24 hours limit","\"00:00:00:00\" ... \"23:59:59:23\"","","\/\/ valid timecode range at 24 fps, with 100 days limit","\"00:00:00:00\" ... \"99 23:59:59:23\""],"type":"codeListing"},{"anchor":"SubFrames-Component","level":2,"text":"SubFrames Component","type":"heading"},{"inlineContent":[{"type":"text","text":"Using the SubFrames timecode component."}],"type":"paragraph"},{"inlineContent":[{"text":"Subframes represent a fraction (subdivision) of a single frame.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Subframes are only used by some software and hardware, and since there are no industry standards, each manufacturer can decide how"},{"type":"text","text":" "},{"type":"text","text":"they want to implement subframes. Subframes are frame rate agnostic, meaning the subframe base (divisor) is mutually exclusive of"},{"type":"text","text":" "},{"type":"text","text":"frame rate."}],"type":"paragraph"},{"inlineContent":[{"text":"For example:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Cubase\/Nuendo","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"Logic Pro","type":"text"}]},{"type":"text","text":" globally use 80 subframes per frame (0 … 79) regardless of frame rate"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Pro Tools"}],"type":"emphasis"},{"text":" uses 100 subframes (0 … 99) globally regardless of frame rate","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Timecode supports subframes throughout. However, by default subframes are not displayed in "},{"identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/stringValue(format:)","type":"reference","isActive":true},{"type":"text","text":". You"},{"type":"text","text":" "},{"type":"text","text":"can enable them:"}],"type":"paragraph"},{"type":"codeListing","code":["var tc = try Timecode(","    .string(\"01:12:20:05.62\"),","    at: .fps24,","    base: .max80SubFrames",")","","\/\/ string with default formatting","tc.stringValue() \/\/ == \"01:12:20:05\"","tc.subFrames     \/\/ == 62 (subframes are preserved even though not displayed in stringValue)","","\/\/ string with subframes shown","tc.stringValue(format: .showSubFrames) \/\/ == \"01:12:20:05.62\""],"syntax":"swift"},{"inlineContent":[{"text":"Subframes are always calculated when performing operations on the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode"},{"text":" instance, even if they are not expressed in the","type":"text"},{"text":" ","type":"text"},{"text":"timecode string when not displaying subframes.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var tc = try Timecode(","    .string(\"00:00:00:00.40\"),","    at: .fps24,","    base: .max80SubFrames",")","","tc.stringValue() \/\/ == \"00:00:00:00\"","tc.stringValue(format: .showSubFrames) \/\/ == \"00:00:00:00.40\"","","\/\/ multiply timecode by 2.","\/\/ 40 subframes is half of a frame at 80 subframes per frame","(tc * 2).stringValue(format: .showSubFrames) \/\/ == \"00:00:00:01.00\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Primitive storage type for timecode component values."}],"type":"paragraph"}]}],"references":{"doc://SwiftTimecodeCore/documentation/SwiftTimecodeCore/Timecode-Comparison-and-Sort":{"abstract":[{"type":"text","text":"Comparing and sorting the ordering of timecodes."}],"identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecod