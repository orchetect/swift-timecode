{"abstract":[{"type":"text","text":"Returns the string value using time value encoding for Final Cut Pro FCPXML files."},{"type":"text","text":" "},{"type":"text","text":"Normalizes the fraction first if necessary."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fcpxmlStringValue","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Where the time value is an even number of seconds, it is encoded as a whole number without","type":"text"},{"text":" ","type":"text"},{"text":"the fraction, ie: “0s” or “60s”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Where a time value is not an even number of seconds, FCPXML uses the string format “N\/Ds”,","type":"text"},{"text":" ","type":"text"},{"text":"ie: “34900\/2500s”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"FCPXML uses a trailing “s” character in the string to denote ‘seconds’.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the value is negative, a minus sign is prepended to the string, ie: “-60s” or","type":"text"},{"text":" ","type":"text"},{"text":"“-34900\/2500s”.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Fraction\/fcpxmlStringValue"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swifttimecodecore\/fraction\/fcpxmlstringvalue"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore","doc:\/\/SwiftTimecodeCo