t":" section","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add a new entry by clicking the "},{"code":"+","type":"codeVoice"},{"type":"text","text":" button"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter the following data in the corresponding fields:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Field"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Content","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Timecode","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Identifier"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.orchetect.timecode","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"app-target-exported-types.png","type":"image"}],"type":"paragraph"},{"anchor":"NSItemProvider","level":2,"type":"heading","text":"NSItemProvider"},{"inlineContent":[{"identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode","type":"reference","isActive":true},{"text":" supports encoding and decoding timecode using one or more ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nsitemprovider","type":"reference","isActive":true},{"text":" instances.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In AppKit, UIKit and SwiftUI, ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nsitemprovider","overridingTitleInlineContent":[{"type":"codeVoice","code":"NSItemProvider"}],"type":"reference","overridingTitle":"NSItemProvider","isActive":true},{"text":" is used commonly to exchange content with the pasteboard.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When using the associated methods, timecode will generate two item providers:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A plain-text timecode string"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A lossless JSON-encoded representation"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This means that the end-user is able to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"paste or drag as a timecode string to any 3rd-party application that can receive plain-text","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"paste or drag to paste destinations within your app that accept the "},{"identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/UniformTypeIdentifiers\/UTType\/timecode","isActive":true,"type":"reference"},{"type":"text","text":" UT Type"}],"type":"paragraph"}]}]},{"code":["struct TimecodeListView: View {","    @State var model: [Timecode]","    @State var selection: Timecode","    ","    var body: some View {","        List(selection: $selection) {","            ForEach(model) { item in","                Text(item.stringValue()).tag(item)","            }","        }","        .onCopyCommand {","            selection.itemProviders()","        }","        .onPasteCommand(of: [.timecode]) { itemProviders in","            Task {","                try await add(itemFrom: itemProviders)","            }","        }","    }","    ","    func add(itemFrom itemProviders: [NSItemProvider]) async throws {","        \/\/ Provide default properties in case only a timecode string is present,","        \/\/ which could be the case if the user copies a plain-text timecode string","        \/\/ from another application. If the timecode data on the pasteboard was","        \/\/ originally created using Timecode's `itemProviders()` method or its","        \/\/ `Transferable` representation, then these properties will be ignored,","        \/\/ as the pasteboard will contain lossless data with which to decode to","        \/\/ the new Timecode instance.","        let properties = model.last?.properties","            ?? Timecode.Properties(rate: .fps24)","        let timecode = try await Timecode(","            from: itemProviders,","            propertiesForString: properties","        )","","        \/\/ Here is where you can validate pasted timecode before accepting it.","        \/\/ See the `validate()` method inline help or Encoding section in the","        \/\/ documentation for details. ","        let validatedTimecode = TimecodeField.validate(pastedTimecode: timecode, ... )","","        \/\/ Finally, accept the pasted timecode","        \/\/ Timecode's default `Identifiable` implementation uses self","        \/\/ which means we cannot have two identical timecodes in a SwiftUI array","        if !model.contains(validatedTimecode) {","            model.append(validatedTimecode) ","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode-Encoding#Pasted-Timecode-Validation-Against-Local-Context","isActive":true},{"text":" section on how to validate pasted timecode.","type":"text"}]},{"style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":""}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If SwiftUI view modifiers using "},{"type":"codeVoice","code":"NSItemProviders"},{"type":"text","text":" are invoked without exporting "},{"type":"codeVoice","code":"Timecode"},{"type":"text","text":"’s UT Type, this error will be thrown:"}],"type":"paragraph"},{"inlineContent":[{"code":"Type \"com.orchetect.timecode\" was expected to be declared and exported in the Info.plist of MyApp.app, but it was not found.","type":"codeVoice"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode-Encoding#UT-Types"},{"type":"text","text":" section for information on how to export this type in your app."}],"type":"paragraph"}],"name":"Important"},{"text":"Transferable","anchor":"Transferable","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode"},{"text":" conforms to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/coretransferable\/transferable"},{"text":" protocol which allows instances to be dragged & dropped or copied to\/from the clipboard using declarative SwiftUI syntax.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example demonstrates a timecode list that supports copy and paste as well as drag and drop in order to copy items to another paste destination (such as a second instance of this view).","type":"text"}]},{"code":["struct TimecodeListView: View {","    @State var model: [Timecode]","    @State var selection: Timecode","    ","    var body: some View {","        List(selection: $selection) {","            ForEach(model) { item in","                Text(item.stringValue()).tag(item)","            }","            .dropDestination(for: Timecode.self) { items, location in","                add(items: items)","                return true","            }","        }","        .copyable([selection])","        .pasteDestination(for: Timecode.self) { items in","            add(items: items)","        }","    }","    ","    func add(items: [Timecode]) {","        for item in items {","            \/\/ Here is where you can validate pasted timecode before accepting it.","            \/\/ See the `validate()` method inline help or Encoding section in the ","            \/\/ documentation for details. ","            let validatedTimecode = TimecodeField.validate(pastedTimecode: item, ... )","","            \/\/ Timecode's default `Identifiable` implementation uses self","            \/\/ which means we cannot have two identical timecodes in a SwiftUI array","            if !model.contains(validatedTimecode) { model.append(validatedTimecode) }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode-Encoding#Pasted-Timecode-Validation-Against-Local-Context"},{"text":" section on how to validate pasted timecode.","type":"text"}]},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If SwiftUI view modifiers using the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/coretransferable\/transferable","overridingTitle":"Transferable","overridingTitleInlineContent":[{"type":"codeVoice","code":"Transferable"}],"isActive":true,"type":"reference"},{"text":" protocol are invoked without exporting ","type":"text"},{"code":"Timecode","type":"codeVoice"},{"text":"’s UT Type, this error will be thrown:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"Type \"com.orchetect.timecode\" was expected to be declared and exported in the Info.plist of MyApp.app, but it was not found.","type":"codeVoice"}],"type":"paragraph"},{"inlineContent":[{"text":"See the ","type":"text"},{"identifier":"doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode-Encoding#UT-Types","isActive":true,"type":"reference"},{"text":" section for information on how to export this type in your app.","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Pasted Timecode Validation Against Local Context","anchor":"Pasted-Timecode-Validation-Against-Local-Context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When accepting timecode pasted from the clipboard, it is common to validate it against a local context."}]},{"type":"paragraph","inlineContent":[{"text":"For example, you may want to constrain pasted timecode to a certain frame rate, subframes base and upper limit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiftTimecodeUI"},{"type":"text","text":" target offers static API to perform this validation by supplying policies to validate against."}]},{"syntax":"swift","code":["@TimecodeState private var timecode: Timecode","","\/\/ pass in the `Timecode` instance received from the pasteboard","\/\/ from the `pasteDestination()` or `onPasteCommand()` view modifiers:","func validate(pastedTimecode: Timecode) {","    guard let newTimecode = TimecodeField.validate(","        pastedTimecode: pastedTimecode,","        localTimecodeProperties: timecode.properties,","        pastePolicy: .preserveLocalProperties,","        validationPolicy: .enforceValid","    ) else { return }","","    timecode = newTimecode","}"],"type":"codeListing"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"}]},{"inlineContent":[{"type":"text","text":"This method is offered on "},{"type":"codeVoice","code":"TimecodeField"},{"type":"text","text":" since it is the same API the field uses internally when handling its own paste events."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"TimecodeField"},{"type":"text","text":" implements copy and paste functionality under the hood, calling the "},{"type":"codeVoice","code":"validate"},{"type":"text","text":" method is unnecessary as it is already being called internally on user paste events."}],"type":"paragraph"},{"inlineContent":[{"text":"Instead, use the corresponding view modifiers to specify the policies on your ","type":"text"},{"code":"TimecodeField","type":"codeVoice"},{"text":" instance:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"timecodeFieldPastePolicy(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"timecodeFieldValidationPolicy(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timecodeFieldInputStyle(_:)"}]}]}]},{"inlineContent":[{"type":"text","text":"See "},{"type":"codeVoice","code":"TimecodeField"},{"type":"text","text":" documentation in the "},{"type":"codeVoice","code":"SwiftTimecodeUI"},{"type":"text","text":" module for more information, or try out the "},{"type":"strong","inlineContent":[{"text":"Timecode UI","type":"text"}]},{"type":"text","text":" example project located in the "},{"type":"strong","inlineContent":[{"type":"text","text":"Examples"}]},{"type":"text","text":" folder within this repo."}],"type":"paragraph"}]}]}],"topicSections":[{"identifiers":["doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/init(from:propertiesForString:)-7ufgh","doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/init(from:propertiesForString:)-5cn3w","doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/itemProviders(stringFormat:)"],"title":"NSItemProvider","anchor":"NSItemProvider"},{"identifiers":["doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/transferRepresentation"],"title":"Transferable","anchor":"Transferable"},{"identifiers":["doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/UniformTypeIdentifiers\/UTType\/timecode","doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/textUTType","doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\/Timecode\/copyUTTypes","doc:\/\/SwiftTimecodeCore\/documentation\/SwiftTimecodeCore\